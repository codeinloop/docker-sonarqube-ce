SONARQUBE_VERSION=26.5.0.122743-community
PLUGIN_VERSION=26.5.0

# Banco
POSTGRES_USER=sonar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sonarqube

# Rede / dominio
# SONAR_BIND=0.0.0.0 expoe a porta na rede; o padrao (loopback) deixa o tunnel como
# unica porta de entrada externa.
SONAR_BIND=127.0.0.1
SONAR_PORT=9000
SONAR_DOMAIN=sonar.example.com

# MCP Server (agentes de IA: Claude Code, Cursor, Copilot...)
# O Community Build nao tem o proxy /mcp embutido (so edicoes comerciais), entao o MCP
# roda como container separado, publicado pelo tunnel no dominio abaixo.
# Versao: tag 1.x.y.z da imagem sonarsource/sonarqube-mcp (hub.docker.com/r/sonarsource/sonarqube-mcp).
MCP_VERSION=1.28.0.4397
MCP_DOMAIN=mcp.sonar.example.com
# Porta local do MCP, mesmo criterio do SONAR_BIND: loopback por padrao.
MCP_BIND=127.0.0.1
MCP_PORT=8080
