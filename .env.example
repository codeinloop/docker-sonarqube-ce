# [VIDEO - PARTE 1] Versoes casadas: o plugin segue o versionamento do SonarQube.
# Plugin 26.5.0 -> SonarQube 26.5.x. Trocar um sem o outro quebra o javaagent.
SONARQUBE_VERSION=26.5.0.122743-community
PLUGIN_VERSION=26.5.0

# Banco
POSTGRES_USER=sonar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sonarqube

# Rede / dominio
# SONAR_BIND=0.0.0.0 expoe a porta na rede; o padrao (loopback) deixa o tunnel como
# unica porta de entrada externa.
SONAR_BIND=127.0.0.1
SONAR_PORT=9000
SONAR_DOMAIN=sonar.codeinloop.net
